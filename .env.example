# Required
BOT_TOKEN=123456:replace-with-token-from-BotFather
OWNER_CHAT_ID=123456789

# Optional (defaults shown)
TZ_NAME=America/New_York
WINDOW_START_HOUR=8
WINDOW_END_HOUR=2
LATE_GRACE_MIN=15

# Starting values for the daily ping count (Poisson). Once you use /mean, /min or /max
# in Telegram, those stored values take over and these are ignored.
PINGS_MEAN=6
# Fewest / most pings a day can have: a whole number, or none for no limit.
PINGS_MIN=none
PINGS_MAX=none
